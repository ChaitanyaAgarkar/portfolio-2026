# Public site origin used for canonical URLs, Open Graph tags, and sitemap generation.
# Do NOT put API secrets, private tokens, or credentials in VITE_ variables.
VITE_SITE_URL=https://chaieeetanya.me

# Optional public contact endpoint (e.g., Formspree URL or public intake webhook).
# When omitted, the contact form cleanly uses the built-in mailto adapter that opens
# the visitor's default email client with prefilled fields.
VITE_CONTACT_ENDPOINT=

# Optional LeetCode stats API override (defaults to public Faisal Shohag endpoint).
VITE_LEETCODE_API_URL=https://leetcode-api-faisalshohag.vercel.app/chaitanyaagarkar

# Optional override for Meru Accounting designation while confirming resume vs. experience wording.
# Accepted values: "Full Stack Developer Intern" | "Full Stack Developer"
VITE_MERU_DESIGNATION=Full Stack Developer Intern

